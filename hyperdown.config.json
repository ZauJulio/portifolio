{
  "$schema": "./node_modules/@indago/hyper-down/schemas/hyperdown.config.schema.json",
  "database": {
    "contentDir": "./content",
    "frontmatterJsonPath": "frontmatter.json",
    "indexByCollection": { "article": "composed" }
  },
  "sitemap": {
    "siteUrl": "https://zaujulio.com",
    "outputPath": "./public/sitemap.xml",
    "mode": "override",
    "staticRoutes": [
      { "path": "/", "priority": "1.0", "changefreq": "weekly" },
      { "path": "/pt", "priority": "1.0", "changefreq": "weekly" },
      { "path": "/cooking", "priority": "0.8", "changefreq": "weekly" },
      { "path": "/pt/cooking", "priority": "0.8", "changefreq": "weekly" },
      { "path": "/articles", "priority": "0.8", "changefreq": "weekly" },
      { "path": "/pt/articles", "priority": "0.8", "changefreq": "weekly" },
      { "path": "/photography", "priority": "0.7", "changefreq": "monthly" },
      { "path": "/pt/photography", "priority": "0.7", "changefreq": "monthly" },
      { "path": "/music", "priority": "0.7", "changefreq": "monthly" },
      { "path": "/pt/music", "priority": "0.7", "changefreq": "monthly" },
      { "path": "/games", "priority": "0.7", "changefreq": "monthly" },
      { "path": "/pt/games", "priority": "0.7", "changefreq": "monthly" },
      { "path": "/books", "priority": "0.7", "changefreq": "monthly" },
      { "path": "/pt/books", "priority": "0.7", "changefreq": "monthly" },
      { "path": "/movies", "priority": "0.7", "changefreq": "monthly" },
      { "path": "/pt/movies", "priority": "0.7", "changefreq": "monthly" },
      { "path": "/links", "priority": "0.6", "changefreq": "monthly" },
      { "path": "/pt/links", "priority": "0.6", "changefreq": "monthly" }
    ],
    "contentTypes": [
      {
        "name": "recipe",
        "basePath": "/cooking",
        "priority": "0.6",
        "changefreq": "monthly"
      },
      {
        "name": "article",
        "basePath": "/articles",
        "priority": "0.7",
        "changefreq": "monthly"
      }
    ]
  },
  "i18n": {
    "defaultLocale": "en",
    "locales": ["en", "pt-BR"],
    "strategy": "folder",
    "filePattern": {}
  }
}
