{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MusicDataStore",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/playlist" },
          { "$ref": "#/definitions/favorite" },
          { "$ref": "#/definitions/channel" }
        ]
      }
    }
  },
  "required": ["items"],
  "definitions": {
    "playlist": {
      "type": "object",
      "required": ["id", "title", "youtubeId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "cover": { "type": "string", "format": "uri" },
        "genre": { "type": "string" },
        "trackCount": { "type": "number" },
        "youtubeId": { "type": "string" }
      }
    },
    "favorite": {
      "type": "object",
      "required": ["id", "title", "artist", "youtubeId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "album": { "type": "string" },
        "cover": { "type": "string", "format": "uri" },
        "genre": { "type": "string" },
        "youtubeId": { "type": "string" }
      }
    },
    "channel": {
      "type": "object",
      "required": ["id", "url"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    }
  }
}
