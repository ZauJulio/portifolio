{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BooksDataStore",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/book" }
    }
  },
  "required": ["items"],
  "additionalProperties": false,
  "definitions": {
    "book": {
      "type": "object",
      "required": ["id", "title", "author", "cover", "status", "genre"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "cover": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["book", "manga", "hq"]
        },
        "status": {
          "type": "string",
          "enum": ["reading", "finished", "want-to-read", "dropped"]
        },
        "genre": { "type": "string" },
        "rating": { "type": "number", "minimum": 0, "maximum": 5 },
        "accentColor": {
          "type": "string",
          "description": "Override accent color as hex (e.g. '#fe0000')"
        },
        "description": { "type": "string" },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["platform", "url"],
            "additionalProperties": false,
            "properties": {
              "platform": { "type": "string" },
              "url": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
