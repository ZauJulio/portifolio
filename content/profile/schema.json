{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProfileContentSchema",
  "type": "object",
  "required": ["name", "title", "email", "social"],
  "properties": {
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "social": {
      "type": "object",
      "properties": {
        "github": {
          "type": "string",
          "format": "uri"
        },
        "linkedin": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ExperienceItem"
      }
    },
    "thesis": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "institution": {
          "type": "string"
        },
        "year": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "links": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "documentation": {
              "type": "string"
            }
          }
        }
      }
    },
    "hobbies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "ExperienceItem": {
      "title": "ExperienceItem",
      "type": "object",
      "required": ["id", "role", "company", "period", "description"],
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
