{
  "name": "portifolio",
  "version": "1.6.7",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vike dev",
    "build": "bun --bun scripts/build.ts",
    "preview": "bun --bun vike preview",
    "start": "NODE_ENV=production bun dist/server/index.mjs",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "bunx playwright test",
    "lint": "oxlint .",
    "format": "oxfmt . --write",
    "check": "bun run lint && bun run format",
    "check:ci": "oxlint . && oxfmt . --check",
    "typecheck": "tsc -p tsconfig.json --pretty --noEmit",
    "prepare": "husky"
  },
